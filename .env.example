NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI: required by /api/tldr today, /api/parse-plan in Phase 5
OPENAI_API_KEY=sk-your-openai-key

# ── Inbound email pipeline (Postmark) ──
# Provider is Postmark, not Resend: it POSTs the fully parsed message in ONE
# payload, so there is no follow-up body fetch that could fail after the
# webhook already returned 200.
#
# Postmark does not HMAC-sign inbound webhooks, so the gate is HTTP Basic auth
# on the webhook URL. Set the webhook in Postmark to:
#   https://user:pass@your-app/api/inbound
# and set this to the base64 of "user:pass" (what the Authorization header
# carries). Generate with:  printf 'user:pass' | base64
INBOUND_WEBHOOK_BASIC=base64-of-user:pass

# Optional defence in depth: comma-separated Postmark source IPs or prefixes.
# Leave unset to rely on Basic auth alone.
# INBOUND_ALLOWED_IPS=

# Phase 0 ONLY. Accepts mail on a From match alone, so the pipeline can be
# exercised with test mail sent from a developer account before a real Gmail
# forwarding rule exists. NEVER set this in production: it reduces the trust
# anchor to a forgeable header.
# INBOUND_TEST_MODE=1

# Shared secret for the cron sweep and watchdog. The same value must be set in
# Postgres for pg_cron to authenticate:
#   alter database postgres set app.settings.cron_secret = '<this value>';
#   alter database postgres set app.settings.app_url     = 'https://tradeladder.io';
CRON_SECRET=generate-a-long-random-string

# F9 / F12 (admin gate + tokenized share URLs) — uncomment when /admin/pitch lands:
# ADMIN_USER_IDS=uuid1,uuid2
# ADMIN_PITCH_TOKEN_SECRET=your-hmac-secret
